{
  "name": "onenote2obsidian",
  "version": "0.2.2",
  "description": "High-fidelity spatial import and GPU rendering of Microsoft OneNote notebooks in Obsidian using PixiJS.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm test",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,css,json}\""
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "onenote",
    "pixijs",
    "spatial-canvas",
    "infinite-canvas",
    "ink",
    "graphics"
  ],
  "author": "OneNote2Obsidian Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lalogeorgi/OneNote2Obsidian.git"
  },
  "bugs": {
    "url": "https://github.com/Lalogeorgi/OneNote2Obsidian/issues"
  },
  "homepage": "https://github.com/Lalogeorgi/OneNote2Obsidian#readme",
  "dependencies": {
    "dompurify": "^3.2.4",
    "pixi.js": "^8.8.1",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.13.4",
    "@types/rbush": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^26.0.0",
    "obsidian": "latest",
    "prettier": "^3.9.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
